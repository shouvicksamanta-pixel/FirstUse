//@version=6
indicator("RSI Oversold Reversal Strategy", overlay=true, max_labels_count=500, max_lines_count=500)

// Input parameters
rsi_length = input.int(25, title="RSI Length", minval=1)
rsi_oversold = input.int(30, title="RSI Oversold Level", minval=1, maxval=50)
lookback_bars = input.int(4, title="Lookback Bars for Green Candle", minval=1, maxval=10)

// Calculate RSI
rsi = ta.rsi(close, rsi_length)

// Define candle colors
is_red_candle = close < open
is_green_candle = close > open

// Track trade state
var bool in_trade = false
var float entry_price = na
var float stop_loss = na
var float target_price = na
var int entry_bar = na
var label entry_label = na
var label exit_label = na
var line sl_line = na
var line target_line = na

// Function to find green candle in lookback period
find_green_candle_in_lookback() =>
    found = false
    green_candle_high = 0.0
    for i = 1 to lookback_bars
        if is_green_candle[i]
            found := true
            green_candle_high := high[i]
            break
    [found, green_candle_high]

// Main strategy logic
if not in_trade
    // Check if current candle meets base criteria
    if is_red_candle and rsi < rsi_oversold
        // Look for green candle in previous 4 bars (Base -1)
        [found_green, green_high] = find_green_candle_in_lookback()
        
        if found_green
            // Check if any subsequent candle closes above the green candle high
            buy_signal = false
            for i = 0 to lookback_bars - 1
                if close[i] > green_high and i < lookback_bars
                    buy_signal := true
                    break
            
            // If buy signal triggered, enter trade on next candle
            if buy_signal
                in_trade := true
                entry_price := close
                stop_loss := low  // Low of the red base candle
                target_price := entry_price + 2 * (entry_price - stop_loss)
                entry_bar := bar_index
                
                // Create entry label
                entry_label := label.new(bar_index, low, "BUY\n" + str.tostring(entry_price, "#.##"), 
                                       color=color.green, style=label.style_label_up, textcolor=color.white, size=size.small)
                
                // Create stop loss line
                sl_line := line.new(bar_index, stop_loss, bar_index + 10, stop_loss, 
                                  color=color.red, style=line.style_dashed, width=2)
                
                // Create target line
                target_line := line.new(bar_index, target_price, bar_index + 10, target_price, 
                                      color=color.green, style=line.style_dashed, width=2)

// Check exit conditions
if in_trade
    exit_trade = false
    exit_reason = ""
    
    // Check if target hit
    if high >= target_price
        exit_trade := true
        exit_reason := "TARGET"
    
    // Check if stop loss hit
    if low <= stop_loss
        exit_trade := true
        exit_reason := "STOP LOSS"
    
    // Exit trade
    if exit_trade
        in_trade := false
        
        // Create exit label
        exit_label := label.new(bar_index, high, "SELL\n" + exit_reason + "\n" + str.tostring(close, "#.##"), 
                               color=color.red, style=label.style_label_down, textcolor=color.white, size=size.small)
        
        // Update line endpoints
        if not na(sl_line)
            line.set_x2(sl_line, bar_index)
        if not na(target_line)
            line.set_x2(target_line, bar_index)
        
        // Reset variables
        entry_price := na
        stop_loss := na
        target_price := na
        entry_bar := na

// Plot RSI for reference (in separate pane)
hline(rsi_oversold, "RSI Oversold", color=color.red, linestyle=hline.style_dashed)
plot(rsi, "RSI", color=color.blue)
hline(70, "RSI Overbought", color=color.red, linestyle=hline.style_dashed)

// Plot buy/sell signals
plotshape(in_trade and bar_index == entry_bar, title="Buy Signal", location=location.belowbar, 
          color=color.green, style=shape.triangleup, size=size.normal)

// Color bars based on trade status
barcolor(in_trade ? color.yellow : na, title="In Trade")

// Display trade information in table
var table info_table = table.new(position.top_right, 2, 6, bgcolor=color.white, border_width=1)

if barstate.islast
    table.cell(info_table, 0, 0, "Parameter", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 0, "Value", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 0, 1, "RSI Length", text_color=color.black)
    table.cell(info_table, 1, 1, str.tostring(rsi_length), text_color=color.black)
    table.cell(info_table, 0, 2, "RSI Level", text_color=color.black)
    table.cell(info_table, 1, 2, str.tostring(rsi_oversold), text_color=color.black)
    table.cell(info_table, 0, 3, "Current RSI", text_color=color.black)
    table.cell(info_table, 1, 3, str.tostring(rsi, "#.##"), text_color=color.black)
    table.cell(info_table, 0, 4, "In Trade", text_color=color.black)
    table.cell(info_table, 1, 4, in_trade ? "YES" : "NO", text_color=in_trade ? color.green : color.red)
    
    if in_trade
        table.cell(info_table, 0, 5, "Entry Price", text_color=color.black)
        table.cell(info_table, 1, 5, str.tostring(entry_price, "#.##"), text_color=color.black)

// Alert conditions
alertcondition(in_trade and bar_index == entry_bar, title="Buy Signal Alert", message="RSI Oversold Reversal - BUY signal triggered")
alertcondition(not in_trade and exit_reason != "", title="Exit Signal Alert", message="Trade closed: {{plot(\"exit_reason\")}}")