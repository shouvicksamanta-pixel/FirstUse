//@version=6
indicator(title="RSI Divergence Indicator v6", shorttitle="RSI Div v6", timeframe="", timeframe_gaps=true)

// Input parameters
len = input.int(title="RSI Period", minval=1, defval=9)
src = input.source(title="RSI Source", defval=close)
lbR = input.int(title="Pivot Lookback Right", defval=3)
lbL = input.int(title="Pivot Lookback Left", defval=1)
rangeUpper = input.int(title="Max of Lookback Range", defval=60)
rangeLower = input.int(title="Min of Lookback Range", defval=5)

// Plot options
plotBull = input.bool(title="Plot Bullish", defval=true)
plotHiddenBull = input.bool(title="Plot Hidden Bullish", defval=true)
plotBear = input.bool(title="Plot Bearish", defval=true)
plotHiddenBear = input.bool(title="Plot Hidden Bearish", defval=false)
showRSIValues = input.bool(title="Show RSI Values at Divergences", defval=true)
plotOnChart = input.bool(title="Plot Divergences on Main Chart", defval=true)

// Color definitions
bearColor = color.purple
bullColor = color.green
hiddenBullColor = color.new(color.green, 80)
hiddenBearColor = color.new(color.red, 80)
textColor = color.white

// Calculate RSI
osc = ta.rsi(src, len)

// Plot RSI and levels
plot(osc, title="RSI", linewidth=2, color=#8D1699)
hline(50, title="Middle Line", linestyle=hline.style_dotted)
obLevel = hline(70, title="Overbought", linestyle=hline.style_dotted)
osLevel = hline(30, title="Oversold", linestyle=hline.style_dotted)
fill(obLevel, osLevel, title="Background", color=color.new(#9915FF, 90))

// Pivot detection functions
plFound = not na(ta.pivotlow(osc, lbL, lbR))
phFound = not na(ta.pivothigh(osc, lbL, lbR))

// Helper function to check if condition is within range
_inRange(cond) =>
    bars = ta.barssince(cond == true)
    rangeLower <= bars and bars <= rangeUpper

// Regular Bullish Divergence
oscHL = osc[lbR] > ta.valuewhen(plFound, osc[lbR], 1) and _inRange(plFound[1])
priceLL = low[lbR] < ta.valuewhen(plFound, low[lbR], 1)
bullCond = plotBull and priceLL and oscHL and plFound

// Hidden Bullish Divergence  
oscLL = osc[lbR] < ta.valuewhen(plFound, osc[lbR], 1) and _inRange(plFound[1])
priceHL = low[lbR] > ta.valuewhen(plFound, low[lbR], 1)
hiddenBullCond = plotHiddenBull and priceHL and oscLL and plFound

// Regular Bearish Divergence
oscLH = osc[lbR] < ta.valuewhen(phFound, osc[lbR], 1) and _inRange(phFound[1])
priceHH = high[lbR] > ta.valuewhen(phFound, high[lbR], 1)
bearCond = plotBear and priceHH and oscLH and phFound

// Hidden Bearish Divergence
oscHH = osc[lbR] > ta.valuewhen(phFound, osc[lbR], 1) and _inRange(phFound[1])
priceLH = high[lbR] < ta.valuewhen(phFound, high[lbR], 1)
hiddenBearCond = plotHiddenBear and priceLH and oscHH and phFound

// Get RSI values at divergence points
bullRSI = bullCond ? osc[lbR] : na
hiddenBullRSI = hiddenBullCond ? osc[lbR] : na
bearRSI = bearCond ? osc[lbR] : na
hiddenBearRSI = hiddenBearCond ? osc[lbR] : na

// Plot divergence labels in RSI pane
if bullCond
    label.new(bar_index - lbR, osc[lbR], 
              text = showRSIValues ? "Bull\n" + str.tostring(math.round(osc[lbR], 1)) : "Bull", 
              style = label.style_label_up, 
              color = bullColor, 
              textcolor = textColor, 
              size = size.small)

if hiddenBullCond
    label.new(bar_index - lbR, osc[lbR], 
              text = showRSIValues ? "H Bull\n" + str.tostring(math.round(osc[lbR], 1)) : "H Bull", 
              style = label.style_label_up, 
              color = hiddenBullColor, 
              textcolor = textColor, 
              size = size.small)

if bearCond
    label.new(bar_index - lbR, osc[lbR], 
              text = showRSIValues ? "Bear\n" + str.tostring(math.round(osc[lbR], 1)) : "Bear", 
              style = label.style_label_down, 
              color = bearColor, 
              textcolor = textColor, 
              size = size.small)

if hiddenBearCond
    label.new(bar_index - lbR, osc[lbR], 
              text = showRSIValues ? "H Bear\n" + str.tostring(math.round(osc[lbR], 1)) : "H Bear", 
              style = label.style_label_down, 
              color = hiddenBearColor, 
              textcolor = textColor, 
              size = size.small)

// Plot divergences on main chart (if enabled)
if plotOnChart
    if bullCond
        label.new(bar_index - lbR, low[lbR], 
                  text = showRSIValues ? "Bull\nRSI:" + str.tostring(math.round(osc[lbR], 1)) : "Bull", 
                  style = label.style_label_up, 
                  color = bullColor, 
                  textcolor = textColor, 
                  size = size.tiny,
                  yloc = yloc.belowbar)
    
    if hiddenBullCond
        label.new(bar_index - lbR, low[lbR], 
                  text = showRSIValues ? "H Bull\nRSI:" + str.tostring(math.round(osc[lbR], 1)) : "H Bull", 
                  style = label.style_label_up, 
                  color = hiddenBullColor, 
                  textcolor = textColor, 
                  size = size.tiny,
                  yloc = yloc.belowbar)
    
    if bearCond
        label.new(bar_index - lbR, high[lbR], 
                  text = showRSIValues ? "Bear\nRSI:" + str.tostring(math.round(osc[lbR], 1)) : "Bear", 
                  style = label.style_label_down, 
                  color = bearColor, 
                  textcolor = textColor, 
                  size = size.tiny,
                  yloc = yloc.abovebar)
    
    if hiddenBearCond
        label.new(bar_index - lbR, high[lbR], 
                  text = showRSIValues ? "H Bear\nRSI:" + str.tostring(math.round(osc[lbR], 1)) : "H Bear", 
                  style = label.style_label_down, 
                  color = hiddenBearColor, 
                  textcolor = textColor, 
                  size = size.tiny,
                  yloc = yloc.abovebar)

// Plot signals for alerting (invisible plots for alert conditions)
plotshape(bullCond, title="Regular Bullish Signal", style=shape.triangleup, location=location.bottom, color=color.new(bullColor, 100), size=size.tiny)
plotshape(hiddenBullCond, title="Hidden Bullish Signal", style=shape.triangleup, location=location.bottom, color=color.new(hiddenBullColor, 100), size=size.tiny)
plotshape(bearCond, title="Regular Bearish Signal", style=shape.triangledown, location=location.top, color=color.new(bearColor, 100), size=size.tiny)
plotshape(hiddenBearCond, title="Hidden Bearish Signal", style=shape.triangledown, location=location.top, color=color.new(hiddenBearColor, 100), size=size.tiny)

// Alert conditions
alertcondition(bullCond, title="Regular Bullish Divergence", message="Regular Bullish RSI Divergence detected at RSI: {{plot(\"RSI\")}}")
alertcondition(hiddenBullCond, title="Hidden Bullish Divergence", message="Hidden Bullish RSI Divergence detected at RSI: {{plot(\"RSI\")}}")
alertcondition(bearCond, title="Regular Bearish Divergence", message="Regular Bearish RSI Divergence detected at RSI: {{plot(\"RSI\")}}")
alertcondition(hiddenBearCond, title="Hidden Bearish Divergence", message="Hidden Bearish RSI Divergence detected at RSI: {{plot(\"RSI\")}}")

// Table to display current RSI value and divergence status
if barstate.islast
    var table infoTable = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 80), border_width=1)
    table.cell(infoTable, 0, 0, "RSI Value", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, str.tostring(math.round(osc, 2)), text_color=color.white, text_size=size.small)
    table.cell(infoTable, 0, 1, "Bull Div", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 1, bullCond ? "✓" : "✗", text_color=bullCond ? bullColor : color.gray, text_size=size.small)
    table.cell(infoTable, 0, 2, "H Bull Div", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 2, hiddenBullCond ? "✓" : "✗", text_color=hiddenBullCond ? bullColor : color.gray, text_size=size.small)
    table.cell(infoTable, 0, 3, "Bear Div", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 3, bearCond ? "✓" : "✗", text_color=bearCond ? bearColor : color.gray, text_size=size.small)
    table.cell(infoTable, 0, 4, "H Bear Div", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 4, hiddenBearCond ? "✓" : "✗", text_color=hiddenBearCond ? bearColor : color.gray, text_size=size.small)